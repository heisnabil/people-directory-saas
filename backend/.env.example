# Backend environment configuration example
# Copy to .env and fill in your actual values

# Application
APP_ENV=development
DEBUG=false

# Database (MySQL via PyMySQL driver)
DATABASE_URL=mysql+pymysql://app_user:change_me@localhost:3306/employee_directory

# Connection pool tuning
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# CORS – comma-separated allowed origins
CORS_ORIGINS=http://localhost:5173

# Logging
LOG_LEVEL=INFO

# Search defaults
SEARCH_MAX_LENGTH=100
DEFAULT_PAGE_LIMIT=20
MAX_PAGE_LIMIT=100
